# Server-only secrets. Never prefix these with VITE_.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-service-role-key
APP_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
PORT=3001
HOST=127.0.0.1
# Server-only Meta Muse credentials. Automatic generation waits when the key is absent.
MODEL_API_KEY=
MUSE_BASE_URL=https://api.meta.ai/v1
MUSE_MODEL=muse-spark-1.3
MUSE_TOUR_LANGUAGE=en-US
# MUSE_TIMEOUT_MS=300000
# Optional local SDK timing/usage viewer; prompts, generated content and images are omitted.
# AI_SDK_DEVTOOLS=true
# Initial explanation depth; teaching profiles can override it per tour.
TOUR_PRESET=standard
# The persistent SDK agent is the default. false opts into the older guided harness.
PAPER_AGENT_ENABLED=true
# PAPER_AGENT_MAX_TURNS=64
# PAPER_AGENT_MAX_OUTPUT_TOKENS=128000
# PAPER_AGENT_MAX_RUNTIME_MS=1200000
# Optional absolute path; defaults to ingest/.venv/bin/python.
# PYTHON_BIN=/absolute/path/to/python

# Optional speech providers: all keys stay server-side. Browser voices remain the initial selection.
OPENAI_TTS_API_KEY=
ELEVENLABS_API_KEY=

# Public browser configuration, also used as Docker build arguments.
# On a local Apple silicon Mac the first API start installs Siri and all downloadable voices.
# SIRI_TTS_AUTO_SETUP=false
# Optional existing siri-tts-cli v2 executable; otherwise a pinned copy is built in .data/siri/.
# SIRI_TTS_BIN=/absolute/path/to/siri-tts

VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=replace-with-public-anon-key
# VITE_API_URL=https://your-api.example.com
