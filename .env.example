# Server-only secrets. Never prefix these with VITE_.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-service-role-key
APP_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
PORT=3001
HOST=127.0.0.1
# Server-only Meta Muse credentials. Automatic generation waits when the key is absent.
MODEL_API_KEY=
MUSE_BASE_URL=https://api.meta.ai/v1
MUSE_MODEL=muse-spark-1.3
MUSE_TOUR_LANGUAGE=en-US
# MUSE_TIMEOUT_MS=300000
# Tours: short main-idea tours (harness) by default; muse is the earlier page-by-page writer.
# Presets: quick (about 6 steps), standard (10-12) or deep (up to 22); never more than 30.
TOUR_WRITER=harness
TOUR_PRESET=standard
# true sends new tours to the persistent paper agent instead, which walks every content page.
PAPER_AGENT_ENABLED=false
# PAPER_AGENT_MAX_TURNS=64
# PAPER_AGENT_MAX_OUTPUT_TOKENS=128000
# PAPER_AGENT_MAX_RUNTIME_MS=1200000
# Optional absolute path; defaults to ingest/.venv/bin/python.
# PYTHON_BIN=/absolute/path/to/python

# Public browser configuration, also used as Docker build arguments.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=replace-with-public-anon-key
# VITE_API_URL=https://your-api.example.com
