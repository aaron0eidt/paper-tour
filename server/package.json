{
  "name": "paper-tour-server",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "node --watch --import tsx src/main.ts",
    "start": "node --import tsx src/main.ts",
    "worker": "node --import tsx src/worker-main.ts",
    "migrate": "node --import tsx src/migrate.ts",
    "import-demo": "node --import tsx src/import-demo.ts",
    "build": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "eval:visuals": "node --import tsx scripts/evaluate-visuals.ts"
  },
  "dependencies": {
    "@ai-sdk/openai": "4.0.104",
    "@ai-sdk/openai-compatible": "3.0.80",
    "@fastify/cors": "^10.1.0",
    "@fastify/static": "^10.1.8",
    "@meta-sam/parser": "0.1.0",
    "@resvg/resvg-js": "2.6.2",
    "@supabase/supabase-js": "^2.58.0",
    "ai": "7.0.156",
    "ajv": "^8.20.0",
    "fast-xml-parser": "5.11.2",
    "fastify": "^5.6.1",
    "katex": "0.19.0",
    "pg": "^8.16.3",
    "pg-boss": "^12.3.0",
    "quickjs-emscripten": "0.32.0",
    "tsx": "^4.20.6"
  },
  "devDependencies": {
    "@ai-sdk/devtools": "1.0.59",
    "@types/node": "^22.18.0",
    "@types/pg": "^8.15.5",
    "prettier": "^3.6.2",
    "typescript": "^5.6.3"
  },
  "overrides": {
    "@ai-sdk/devtools": {
      "@hono/node-server": "2.1.5"
    }
  }
}
