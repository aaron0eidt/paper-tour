{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "paper-tour/tour@0.1",
  "title": "Paper Tour script",
  "description": "A narrated walkthrough of one paper. Steps refer to doc.json elements by ID only, never by coordinates; the player resolves IDs to rects. A hand-written tour and an LLM-written tour use the same format.",
  "type": "object",
  "required": [
    "schema",
    "title",
    "paper",
    "chapters"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "paper-tour/tour@0.1"
    },
    "title": {
      "type": "string"
    },
    "paper": {
      "type": "string",
      "description": "Folder name of the paper under demo/, e.g. \"attention\"."
    },
    "doc_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "source.sha256 of the doc.json this tour was written against."
    },
    "level": {
      "enum": [
        "intro",
        "grad",
        "expert"
      ]
    },
    "voices": {
      "type": "object",
      "description": "Voice settings per speaker name. Steps whose speaker has no entry use the default voice.",
      "additionalProperties": {
        "$ref": "#/$defs/voice"
      }
    },
    "chapters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "steps"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "steps": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/step"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "voice": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "lang": {
          "type": "string",
          "description": "BCP 47 tag, e.g. \"en-US\"."
        },
        "name_hint": {
          "type": "string",
          "description": "Substring of a preferred browser voice name, e.g. \"Samantha\"."
        },
        "rate": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 2
        },
        "pitch": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        }
      }
    },
    "step": {
      "type": "object",
      "required": [
        "id",
        "say",
        "actions"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique across the whole tour."
        },
        "speaker": {
          "type": "string",
          "default": "host"
        },
        "say": {
          "type": "string",
          "minLength": 1,
          "description": "Narration. Words are counted by splitting on whitespace; at_word indexes into that list."
        },
        "hold_ms": {
          "type": "integer",
          "minimum": 0,
          "default": 300,
          "description": "Pause after the narration before the next step."
        },
        "audio": {
          "type": "object",
          "description": "Pre-rendered narration. When absent, the player speaks `say` with the browser's speech synthesis.",
          "required": [
            "src"
          ],
          "additionalProperties": false,
          "properties": {
            "src": {
              "type": "string",
              "description": "Relative to the paper folder."
            },
            "duration_ms": {
              "type": "integer",
              "minimum": 0
            },
            "word_times_ms": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0
              },
              "description": "Start time of each word of `say`."
            }
          }
        },
        "actions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/action"
          }
        }
      }
    },
    "targetId": {
      "type": "string",
      "description": "Any doc.json ID: block (p3.b2), sentence (p3.s12), section (sec-3.2), figure or table (fig1, tab2), panel (fig2.a), equation (eq1), or a whole page (page4).",
      "pattern": "^(p[1-9][0-9]*\\.[bs][1-9][0-9]*|sec-[a-z0-9][a-z0-9.-]*|(fig|tab)[0-9A-Za-z]+(\\.[a-z])?|eq[0-9A-Za-z]+|page[1-9][0-9]*)$"
    },
    "region": {
      "type": "array",
      "description": "Sub-area of the target, normalized to the target's bbox: [x0, y0, x1, y1] with 0 to 1 values. Use it to point inside a figure when no panel ID fits.",
      "items": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      },
      "minItems": 4,
      "maxItems": 4
    },
    "atWord": {
      "type": "integer",
      "minimum": 0,
      "default": 0,
      "description": "Fire when narration reaches this word index of `say`. 0 = at step start."
    },
    "persist": {
      "type": "boolean",
      "default": false,
      "description": "Keep this overlay on screen after the step ends, until a `clear` action."
    },
    "action": {
      "type": "object",
      "required": [
        "type"
      ],
      "oneOf": [
        {
          "description": "Move the camera so the target is in view at reading zoom (page width fits the viewport).",
          "properties": {
            "type": {
              "const": "focus"
            },
            "target": {
              "$ref": "#/$defs/targetId"
            },
            "at_word": {
              "$ref": "#/$defs/atWord"
            }
          },
          "required": [
            "type",
            "target"
          ],
          "additionalProperties": false
        },
        {
          "description": "Move and zoom the camera so the target (or a region of it) fills the viewport.",
          "properties": {
            "type": {
              "const": "zoom"
            },
            "target": {
              "$ref": "#/$defs/targetId"
            },
            "region": {
              "$ref": "#/$defs/region"
            },
            "padding": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "default": 0.12,
              "description": "Margin around the target as a fraction of its size."
            },
            "at_word": {
              "$ref": "#/$defs/atWord"
            }
          },
          "required": [
            "type",
            "target"
          ],
          "additionalProperties": false
        },
        {
          "description": "Marker-style highlight that hugs the text lines of each target.",
          "properties": {
            "type": {
              "const": "highlight"
            },
            "targets": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/targetId"
              }
            },
            "color": {
              "$ref": "#/$defs/color"
            },
            "style": {
              "enum": [
                "marker",
                "underline"
              ],
              "default": "marker"
            },
            "at_word": {
              "$ref": "#/$defs/atWord"
            },
            "persist": {
              "$ref": "#/$defs/persist"
            }
          },
          "required": [
            "type",
            "targets"
          ],
          "additionalProperties": false
        },
        {
          "description": "Outline around the target or a region of it, with an optional label.",
          "properties": {
            "type": {
              "const": "box"
            },
            "target": {
              "$ref": "#/$defs/targetId"
            },
            "region": {
              "$ref": "#/$defs/region"
            },
            "label": {
              "type": "string"
            },
            "color": {
              "$ref": "#/$defs/color"
            },
            "at_word": {
              "$ref": "#/$defs/atWord"
            },
            "persist": {
              "$ref": "#/$defs/persist"
            }
          },
          "required": [
            "type",
            "target"
          ],
          "additionalProperties": false
        },
        {
          "description": "Dim everything except the target or a region of it.",
          "properties": {
            "type": {
              "const": "spotlight"
            },
            "target": {
              "$ref": "#/$defs/targetId"
            },
            "region": {
              "$ref": "#/$defs/region"
            },
            "at_word": {
              "$ref": "#/$defs/atWord"
            },
            "persist": {
              "$ref": "#/$defs/persist"
            }
          },
          "required": [
            "type",
            "target"
          ],
          "additionalProperties": false
        },
        {
          "description": "Callout card next to the anchor. Supports **bold** and `code` only.",
          "properties": {
            "type": {
              "const": "note"
            },
            "anchor": {
              "$ref": "#/$defs/targetId"
            },
            "region": {
              "$ref": "#/$defs/region"
            },
            "text": {
              "type": "string",
              "minLength": 1
            },
            "side": {
              "enum": [
                "auto",
                "right",
                "left",
                "top",
                "bottom"
              ],
              "default": "auto"
            },
            "at_word": {
              "$ref": "#/$defs/atWord"
            },
            "persist": {
              "$ref": "#/$defs/persist"
            }
          },
          "required": [
            "type",
            "anchor",
            "text"
          ],
          "additionalProperties": false
        },
        {
          "description": "Remove all persistent overlays.",
          "properties": {
            "type": {
              "const": "clear"
            },
            "at_word": {
              "$ref": "#/$defs/atWord"
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        }
      ]
    },
    "color": {
      "enum": [
        "yellow",
        "blue",
        "green",
        "pink",
        "orange"
      ],
      "default": "yellow"
    }
  }
}
