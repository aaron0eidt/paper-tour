{
  "name": "paper-tour",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,worker,web \"npm --prefix server run dev\" \"npm --prefix server run worker\" \"npm --prefix player run dev\"",
    "dev:demo": "npm --prefix player run dev",
    "build": "npm --prefix server run build && npm --prefix player run build",
    "test": "npm --prefix player test && npm --prefix server test && ingest/.venv/bin/python -m unittest discover -s ingest -p 'test_*.py' && node --test scripts/*.test.mjs",
    "db:migrate": "npm --prefix server run migrate",
    "import:demo": "npm --prefix server run import-demo --",
    "supabase:start": "node scripts/supabase-local.mjs start",
    "supabase:stop": "node scripts/supabase-local.mjs stop",
    "supabase:status": "node scripts/supabase-local.mjs status",
    "setup:local": "node scripts/setup-local.mjs",
    "test:smoke": "node scripts/smoke-local.mjs",
    "test:smoke:muse": "node scripts/smoke-muse.mjs",
    "test:integration": "node scripts/test-integration.mjs",
    "preflight": "node scripts/preflight.mjs",
    "demo:prepare": "node scripts/demo-prepare.mjs",
    "demo:offline": "node scripts/demo-offline.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "concurrently": "^10.0.6",
    "supabase": "^2.122.0"
  }
}
