              "color": "orange",
              "at_word": 31
            }
          ]
        },
        {
          "id": "check-1",
          "say": "Before the next step: if self-attention is limited to a nearby neighborhood for very long inputs, what happens to the longest dependency path?",
          "actions": [
            {
              "type": "focus",
              "target": "p7.s2"
            }
          ],
          "checkpoint": {
            "prompt": "Before the next step: if self-attention is limited to a nearby neighborhood for very long inputs, what happens to the longest dependency path?",
            "hints": [
              "Think back to the part about handling very long sequences.",
              "Full attention links any two spots in one step; limited windows change that.",
              "Longer spans then need many hops chained together."
            ]
          }
        },
        {
          "id": "check-1-answer",
          "say": "It grows to order n over r. Restricting each position to r neighbors forces signals to hop across more steps to span the sequence.",
