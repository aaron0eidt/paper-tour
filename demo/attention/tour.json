    {
      "id": "claim-2",
      "title": "Faster more parallelizable training",
      "steps": [
        {
          "id": "idea-2",
          "say": "The Transformer trains much faster and parallelizes better because self-attention handles all positions together. The old recurrent way builds h_t from h_{t-1} step by step, so n tokens need n sequential steps, while the illustrative timeline shows those n steps collapsing into one parallel attention block.",
          "actions": [
            {
              "type": "focus",
              "target": "p6.s25"
            },
            {
              "type": "board",
              "item": {
                "kind": "timeline",
                "title": "Illustrative chain versus one step",
                "unit": "step",
                "source": "illustrative",
                "anchor": {
