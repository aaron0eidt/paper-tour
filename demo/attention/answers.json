    {
      "question": "Why mask future positions in decoder?",
      "step_id": "takeaway-1",
      "response_language": null,
      "saved_at": "2026-10-30T17:45:40.149Z",
      "seconds": 5.2,
      "answer": {
        "answerable": "yes",
        "steps": [
          {
            "id": "ask-fa9d1b55-1",
            "say": "The decoder masks future positions to preserve the auto-regressive property. That way the prediction for position i can depend only on the known outputs at positions less than i.",
            "actions": [
              {
                "type": "focus",
                "target": "p5.s18"
              },
              {
                "type": "highlight",
                "targets": [
                  "p5.s18"
                ],
                "color": "yellow",
                "at_word": 5
              },
              {
                "type": "focus",
                "target": "p3.s14",
                "at_word": 19
              },
              {
                "type": "highlight",
                "targets": [
                  "p3.s14"
                ],
                "color": "yellow",
                "at_word": 19
              }
            ]
          },
          {
            "id": "ask-fa9d1b55-2",
            "say": "The authors modify decoder self-attention to prevent positions from attending to subsequent positions. As background, training is parallel, so without this the model could peek ahead. They implement this inside scaled dot-product attention by masking out illegal connections.",
